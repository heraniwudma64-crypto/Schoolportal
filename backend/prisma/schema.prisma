generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String              @id
  loginId           String              @unique
  password          String
  email             String?             @unique
  role              Role                @default(TEACHER)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)"))
  avatarUrl         String?
  isActive          Boolean             @default(true)
  isDeleted         Boolean             @default(false)
  lastLoginAt       DateTime?
  phoneNumber       String?
  otpCode           String?
  otpExpiresAt      DateTime?
  name              String?
  resetOtp          String?
  resetOtpExpiresAt DateTime?
  Course            Course[]
  Enrollment        Enrollment[]
  Notice            Notice[]
  Parent            Parent?
  Student           Student?
  StudentAttendance StudentAttendance[]
  Teacher           Teacher?
  materials         Material[]
}

model AcademicYear {
  id                    String                  @id
  year                  String                  @unique
  startDate             DateTime
  endDate               DateTime
  isCurrent             Boolean                 @default(false)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  ClassSection          ClassSection[]
  GradeSubject          GradeSubject[]
  SectionSubjectTeacher SectionSubjectTeacher[]
  StudentEnrollment     StudentEnrollment[]
  Term                  Term[]
}

model Term {
  id             String        @id
  name           String
  academicYearId String
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  Examination    Examination[]
  AcademicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
}

model GradeLevel {
  id                String              @id @default(uuid())
  name              String
  gradeNumber       Int?
  status            String              @default("ACTIVE")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  ClassSection      ClassSection[]
  GradeSubject      GradeSubject[]
  Notice            Notice[]
  StudentEnrollment StudentEnrollment[]
}

model ClassSection {
  id                    String                  @id
  name                  String
  teacherId             String?
  academicYearId        String?
  capacity              Int?
  createdAt             DateTime                @default(now())
  roomNumber            String?
  updatedAt             DateTime                @updatedAt
  gradeLevelId          String?
  status                String                  @default("ACTIVE")
  Assignment            Assignment[]
  AcademicYear          AcademicYear?           @relation(fields: [academicYearId], references: [id])
  GradeLevel            GradeLevel?             @relation(fields: [gradeLevelId], references: [id])
  Teacher               Teacher?                @relation(fields: [teacherId], references: [id])
  Examination           Examination[]
  Notice                Notice[]
  SectionSubjectTeacher SectionSubjectTeacher[]
  students              Student[]
  StudentAttendance     StudentAttendance[]
  StudentEnrollment     StudentEnrollment[]
  Timetable             Timetable[]
}

model Class {
  id           String         @id @default(uuid())
  name         String
  section      String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  assignments  Assignment[]
  teachers     ClassTeacher[]
  examinations Examination[]
}

model Student {
  id                String              @id
  userId            String              @unique
  admissionNo       String              @unique
  firstName         String
  lastName          String
  classSectionId    String?
  parentId          String?
  address           String?
  createdAt         DateTime            @default(now())
  dob               DateTime?
  emergencyContact  String?
  gender            String?
  status            StudentStatus       @default(ACTIVE)
  updatedAt         DateTime
  ExamAttempt       ExamAttempt[]
  FeeInvoice        FeeInvoice[]
  grades            Grade[]
  Notice            Notice[]
  ClassSection      ClassSection?       @relation(fields: [classSectionId], references: [id])
  Parent            Parent?             @relation(fields: [parentId], references: [id])
  User              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  StudentAssignment StudentAssignment[]
  StudentAttendance StudentAttendance[]
  StudentEnrollment StudentEnrollment[]
  submissions       Submission[]
}

model Teacher {
  id                    String                  @id
  userId                String                  @unique
  firstName             String
  lastName              String
  address               String?
  createdAt             DateTime                @default(now())
  phoneNumber           String?
  qualification         String?
  staffId               String?                 @unique
  updatedAt             DateTime
  assignments           Assignment[]
  ClassSection          ClassSection[]
  classes               ClassTeacher[]
  examinations          Examination[]
  SectionSubjectTeacher SectionSubjectTeacher[]
  subjects              Subject[]
  User                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  Timetable             Timetable[]
}

model ClassTeacher {
  id        String  @id @default(uuid())
  classId   String
  teacherId String
  class     Class   @relation(fields: [classId], references: [id])
  teacher   Teacher @relation(fields: [teacherId], references: [id])
}

model Parent {
  id           String    @id
  userId       String    @unique
  firstName    String
  lastName     String
  createdAt    DateTime  @default(now())
  occupation   String?
  phoneNumber  String?
  relationship String?
  updatedAt    DateTime
  Notice       Notice[]
  User         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Student      Student[]
}

model Course {
  id          String       @id
  title       String
  description String?
  teacherId   String
  createdAt   DateTime     @default(now())
  User        User         @relation(fields: [teacherId], references: [id])
  Enrollment  Enrollment[]
}

model Enrollment {
  id        String   @id
  studentId String
  courseId  String
  createdAt DateTime @default(now())
  Course    Course   @relation(fields: [courseId], references: [id])
  User      User     @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseId])
}

model StudentEnrollment {
  id             String        @id @default(uuid())
  studentId      String
  academicYearId String
  gradeLevelId   String
  classSectionId String?
  enrollmentDate DateTime      @default(now())
  status         String        @default("ACTIVE")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  AcademicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  ClassSection   ClassSection? @relation(fields: [classSectionId], references: [id])
  GradeLevel     GradeLevel    @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  Student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
}

model Subject {
  id                    String                  @id
  code                  String                  @unique
  name                  String
  description           String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  status                String                  @default("ACTIVE")
  type                  String?                 @default("CORE")
  teacherId             String?
  Examination           Examination[]
  GradeSubject          GradeSubject[]
  SectionSubjectTeacher SectionSubjectTeacher[]
  teacher               Teacher?                @relation(fields: [teacherId], references: [id])
  Timetable             Timetable[]
}

model GradeSubject {
  id             String        @id @default(uuid())
  academicYearId String?
  gradeLevelId   String
  subjectId      String
  createdAt      DateTime      @default(now())
  AcademicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  GradeLevel     GradeLevel    @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  Subject        Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, gradeLevelId, subjectId])
}

model SectionSubjectTeacher {
  id             String       @id @default(uuid())
  classSectionId String
  subjectId      String
  teacherId      String
  academicYearId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  AcademicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  ClassSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  Subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  Teacher        Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classSectionId, subjectId, academicYearId])
}

model Timetable {
  id             String       @id
  classSectionId String
  teacherId      String
  dayOfWeek      String
  startTime      String
  endTime        String
  createdAt      DateTime     @default(now())
  subjectId      String
  updatedAt      DateTime
  ClassSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  Subject        Subject      @relation(fields: [subjectId], references: [id])
  Teacher        Teacher      @relation(fields: [teacherId], references: [id])
}

model Examination {
  id             String              @id @default(uuid())
  title          String
  classSectionId String
  totalMarks     Float
  examDate       DateTime
  createdAt      DateTime            @default(now())
  passingMarks   Float?
  subjectId      String
  termId         String?
  type           ExamType            @default(MIDTERM)
  updatedAt      DateTime
  weightage      Float?
  classId        String
  teacherId      String?
  duration       Int
  status         ExamStatus          @default(DRAFT)
  ExamAttempt    ExamAttempt[]
  Class          Class               @relation(fields: [classId], references: [id])
  ClassSection   ClassSection        @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  Subject        Subject             @relation(fields: [subjectId], references: [id])
  Teacher        Teacher?            @relation(fields: [teacherId], references: [id])
  Term           Term?               @relation(fields: [termId], references: [id])
  grades         Grade[]
  questions      Question[]
  results        StudentExamResult[]
}

model Question {
  id          String              @id @default(uuid())
  examId      String
  text        String
  options     Option[]
  examination Examination         @relation(fields: [examId], references: [id], onDelete: Cascade)
  results     StudentExamResult[]
  grades      Grade[]             @relation("GradeToQuestion")
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  optionText String
  isCorrect  Boolean  @default(false)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model StudentExamResult {
  id            String          @id @default(uuid())
  examId        String
  studentId     String
  score         Int
  totalMarks    Int
  submittedAt   DateTime        @default(now())
  marksObtained Float           @default(0)
  questionId    String?
  answers       StudentAnswer[]
  examination   Examination     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question      Question?       @relation(fields: [questionId], references: [id])
}

model StudentAnswer {
  id               String            @id @default(uuid())
  resultId         String
  questionId       String
  selectedOptionId String
  isCorrect        Boolean
  result           StudentExamResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
}

model ExamAttempt {
  id            String      @id
  examId        String
  studentId     String
  marksObtained Float
  grade         String?
  createdAt     DateTime    @default(now())
  remarks       String?
  updatedAt     DateTime
  Examination   Examination @relation(fields: [examId], references: [id], onDelete: Cascade)
  Student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
}

model StudentAttendance {
  id             String           @id
  studentId      String
  classSectionId String
  recordedById   String
  date           DateTime
  period         Int?
  status         AttendanceStatus
  remarks        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  ClassSection   ClassSection     @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  User           User             @relation(fields: [recordedById], references: [id])
  Student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date, period])
  @@index([classSectionId, date])
  @@index([studentId, date])
}

model Assignment {
  id                String              @id @default(uuid())
  title             String
  instructions      String?
  subject           String?
  targetClass       String?
  dueDate           DateTime
  attachmentUrl     String?
  classSectionId    String?
  createdAt         DateTime            @default(now())
  classId           String?
  teacherId         String
  description       String?
  updatedAt         DateTime            @default(now()) @updatedAt
  Class             Class?              @relation(fields: [classId], references: [id])
  ClassSection      ClassSection?       @relation(fields: [classSectionId], references: [id])
  Teacher           Teacher             @relation(fields: [teacherId], references: [id])
  grades            Grade[]
  StudentAssignment StudentAssignment[]
  submissions       Submission[]

  @@map("Assignment")
}

model Submission {
  id           String     @id @default(uuid())
  assignmentId String
  studentId    String
  createdAt    DateTime   @default(now())
  grades       Grade[]
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model StudentAssignment {
  id             String     @id
  assignmentId   String
  studentId      String?
  studentLoginId String
  status         String     @default("PENDING")
  Assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  Student        Student?   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model FeeInvoice {
  id         String       @id
  studentId  String
  title      String
  amount     Float
  dueDate    DateTime
  isPaid     Boolean      @default(false)
  paidAt     DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime
  Student    Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  FeePayment FeePayment[]
}

model FeePayment {
  id            String        @id
  invoiceId     String
  amountPaid    Float
  paymentDate   DateTime      @default(now())
  paymentMethod PaymentMethod @default(CASH)
  transactionId String?       @unique
  remarks       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  FeeInvoice    FeeInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Notice {
  id           String           @id @default(uuid())
  title        String
  content      String
  authorId     String
  createdAt    DateTime         @default(now())
  targetRole   Role?
  updatedAt    DateTime         @updatedAt
  category     String           @default("General")
  expiresAt    DateTime?
  gradeId      String?
  parentId     String?
  publishedAt  DateTime?
  scheduledAt  DateTime?
  sectionId    String?
  status       NoticeStatus     @default(DRAFT)
  studentId    String?
  targetType   NoticeTargetType @default(GLOBAL)
  User         User             @relation(fields: [authorId], references: [id])
  GradeLevel   GradeLevel?      @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  Parent       Parent?          @relation(fields: [parentId], references: [id], onDelete: Cascade)
  ClassSection ClassSection?    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  Student      Student?         @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Grade {
  id            String       @id @default(uuid())
  studentId     String
  examinationId String?
  score         Float        @default(0)
  assignmentId  String?
  createdAt     DateTime     @default(now())
  maxScore      Float        @default(100)
  submissionId  String?
  updatedAt     DateTime     @updatedAt
  assignment    Float?       @default(0)
  classwork     Float?       @default(0)
  final         Float?       @default(0)
  mid           Float?       @default(0)
  quarter       String?
  quiz          Float?       @default(0)
  subject       String?
  Assignment    Assignment?  @relation(fields: [assignmentId], references: [id])
  Examination   Examination? @relation(fields: [examinationId], references: [id])
  student       Student      @relation(fields: [studentId], references: [id])
  Submission    Submission?  @relation(fields: [submissionId], references: [id])
  questions     Question[]   @relation("GradeToQuestion")
}

model Material {
  id          String    @id @default(uuid())
  title       String
  category    String?   @map("category")
  description String?
  fileUrl     String?   @map("file_url")
  fileName    String?   @map("file_name")
  fileType    String?   @map("file_type")
  fileSize    Int?      @map("file_size")
  targetRole  String?   @map("target_role")
  createdAt   DateTime? @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("materials")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ExamType {
  QUIZ
  MIDTERM
  FINAL
  ASSIGNMENT
  PROJECT
}

enum ExamStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  ONLINE_GATEWAY
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  SUSPENDED
  TRANSFERRED
}

enum NoticeStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  EXPIRED
  ARCHIVED
}

enum NoticeTargetType {
  GLOBAL
  ROLE
  GRADE
  SECTION
  STUDENT
  PARENT
}
