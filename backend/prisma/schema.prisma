generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ExamType {
  QUIZ
  MIDTERM
  FINAL
  ASSIGNMENT
  PROJECT
}

enum ExamStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  ONLINE_GATEWAY
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  SUSPENDED
  TRANSFERRED
}

enum NoticeStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  EXPIRED
  ARCHIVED
}

enum NoticeTargetType {
  GLOBAL
  ROLE
  GRADE
  SECTION
  STUDENT
  PARENT
}

enum ResultStatus {
  DRAFT
  SUBMITTED
  PUBLISHED
}

model SubjectResult {
  id             String       @id @default(uuid())
  studentId      String
  subjectId      String
  classSectionId String
  academicYearId String
  term           String // e.g., "TERM_1"
  marks          Float
  status         ResultStatus @default(DRAFT)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  Student      Student      @relation(fields: [studentId], references: [id])
  Subject      Subject      @relation(fields: [subjectId], references: [id])
  ClassSection ClassSection @relation(fields: [classSectionId], references: [id])
  AcademicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, subjectId, classSectionId, academicYearId, term])
  @@index([academicYearId, classSectionId, status])
}

model ReportCard {
  id             String       @id @default(uuid())
  studentId      String
  classSectionId String
  academicYearId String
  term           String
  totalMarks     Float
  average        Float
  rank           Int
  status         ResultStatus @default(DRAFT)
  createdAt      DateTime     @default(now())

  Student      Student      @relation(fields: [studentId], references: [id])
  ClassSection ClassSection @relation(fields: [classSectionId], references: [id])
  AcademicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, classSectionId, academicYearId, term])
}

// ─── Core Auth / User ─────────────────────────────────────────────────────────

model User {
  id                String    @id
  loginId           String    @unique
  name              String?
  password          String
  email             String?   @unique
  role              Role      @default(TEACHER)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)"))
  avatarUrl         String?
  isActive          Boolean   @default(true)
  isDeleted         Boolean   @default(false)
  lastLoginAt       DateTime?
  phoneNumber       String?
  otpCode           String?
  otpExpiresAt      DateTime?
  resetOtp          String?
  resetOtpExpiresAt DateTime?

  // Relations
  Course            Course[]
  Enrollment        Enrollment[]
  Notice            Notice[]
  Parent            Parent?
  Student           Student?
  StudentAttendance StudentAttendance[]
  Teacher           Teacher?
  materials         Material[]

  @@index([isDeleted, role, isActive])
}

// ─── Academic Year & Terms ────────────────────────────────────────────────────

model AcademicYear {
  id        String   @id
  year      String   @unique
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime

  ClassSection      ClassSection[]
  Term              Term[]
  StudentEnrollment StudentEnrollment[]
  GradeSubject      GradeSubject[]
  subjectResults    SubjectResult[]
  reportCards       ReportCard[]
  sectionSubjectTeachers SectionSubjectTeacher[]
}

model Term {
  id             String   @id
  name           String
  academicYearId String
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime

  Examination  Examination[]
  AcademicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
}

// ─── Classes / Sections ───────────────────────────────────────────────────────

model GradeLevel {
  id          String   @id @default(uuid())
  name        String
  gradeNumber Int?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ClassSection      ClassSection[]
  GradeSubject      GradeSubject[]
  StudentEnrollment StudentEnrollment[]
  Notice            Notice[]
}

model ClassSection {
  id             String   @id
  name           String
  academicYearId String?
  capacity       Int?
  createdAt      DateTime @default(now())
  roomNumber     String?
  updatedAt      DateTime @updatedAt
  gradeLevelId   String?
  status         String   @default("ACTIVE")
  teacherId      String?  

  Assignment        Assignment[]
  AcademicYear      AcademicYear?         @relation(fields: [academicYearId], references: [id])
  GradeLevel        GradeLevel?           @relation(fields: [gradeLevelId], references: [id])
  Examination       Examination[]
  students          Student[]
  StudentAttendance StudentAttendance[]
  Timetable         Timetable[]
  StudentEnrollment StudentEnrollment[]
  Notice            Notice[]
  subjectResults    SubjectResult[]
  reportCards       ReportCard[]
  subjectTeachers   SectionSubjectTeacher[]
  materials         Material[]

  Teacher           Teacher?              @relation("GeneralTeacher", fields: [teacherId], references: [id], map: "ClassSection_general_teacher_fkey")
  homeroomTeacher   Teacher?              @relation("HomeroomTeacher", fields: [teacherId], references: [id], map: "ClassSection_homeroom_teacher_fkey")

  // Canonical identity for newly-created sections. Legacy rows may have a
  // missing year/grade and are deliberately excluded from enrollment flows.
  @@unique([academicYearId, gradeLevelId, name])
  @@index([teacherId])
}

model Class {
  id           String         @id @default(uuid())
  name         String
  section      String?
  teachers     ClassTeacher[]
  examinations Examination[]
  assignments  Assignment[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// ─── People ───────────────────────────────────────────────────────────────────

model Student {
  id                   String        @id
  userId               String        @unique
  admissionNo          String        @unique
  firstName            String
  lastName             String
  classSectionId       String?
  parentId             String?
  address              String?
  createdAt            DateTime      @default(now())
  dob                  DateTime?
  emergencyContact     String?
  gender               String?
  institutionId        String?
  institutionName      String?
  fatherName           String?
  grandfatherName      String?
  admissionType        String?
  hasDisability        Boolean       @default(false)
  disabilityType       String?
  nationality          String?
  familyKebele         String?
  locationType         String?
  fatherEducationLevel String?
  motherEducationLevel String?
  economicStatus       String?
  guardianFullName     String?
  familyHeadGender     String?
  guardianEmail        String?
  guardianPhone        String?
  nationalId           String?
  residenceRegion      String?
  residenceZone        String?
  residenceWoreda      String?
  birthRegion          String?
  birthZone            String?
  birthWoreda          String?
  parentStatus         String?
  status               StudentStatus @default(ACTIVE)
  updatedAt            DateTime

  ExamAttempt       ExamAttempt[]
  FeeInvoice        FeeInvoice[]
  ClassSection      ClassSection?       @relation(fields: [classSectionId], references: [id])
  Parent            Parent?             @relation(fields: [parentId], references: [id])
  User              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  StudentAssignment StudentAssignment[]
  StudentAttendance StudentAttendance[]
  StudentEnrollment StudentEnrollment[]
  Notice            Notice[]
  submissions       Submission[]
  grades            Grade[]
  subjectResults    SubjectResult[]
  reportCards       ReportCard[]

  @@index([classSectionId, status])
  @@index([parentId])
}

model Teacher {
  id             String   @id
  userId         String   @unique
  firstName      String
  lastName       String
  address        String?
  createdAt      DateTime @default(now())
  phoneNumber    String?
  qualification  String?
  staffId        String?  @unique
  updatedAt      DateTime

  ClassSection       ClassSection[] @relation("GeneralTeacher") // Added relation name here
  User               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  Timetable          Timetable[]
  classes            ClassTeacher[]
  subjects           Subject[]
  assignments        Assignment[]
  examinations       Examination[]
  homeroomSections   ClassSection[] @relation("HomeroomTeacher")
  subjectSections    SectionSubjectTeacher[]
}

model ClassTeacher {
  id        String  @id @default(uuid())
  classId   String
  class     Class   @relation(fields: [classId], references: [id])
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
}

model Parent {
  id           String   @id
  userId       String   @unique
  firstName    String
  lastName     String
  createdAt    DateTime @default(now())
  occupation   String?
  phoneNumber  String?
  relationship String?
  updatedAt    DateTime

  User    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Student Student[]
  Notice  Notice[]
}

// ─── Courses & Enrollments ────────────────────────────────────────────────────

model Course {
  id          String   @id
  title       String
  description String?
  teacherId   String
  createdAt   DateTime @default(now())

  User       User         @relation(fields: [teacherId], references: [id])
  Enrollment Enrollment[]
}

model Enrollment {
  id        String   @id
  studentId String
  courseId  String
  createdAt DateTime @default(now())

  Course Course @relation(fields: [courseId], references: [id])
  User   User   @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseId])
}

model StudentEnrollment {
  id             String   @id @default(uuid())
  studentId      String
  academicYearId String
  gradeLevelId   String
  classSectionId String?
  enrollmentDate DateTime @default(now())
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  Student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  AcademicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  GradeLevel   GradeLevel    @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  ClassSection ClassSection? @relation(fields: [classSectionId], references: [id], onDelete: SetNull)

  @@unique([studentId, academicYearId])
  @@index([academicYearId, gradeLevelId, classSectionId, status])
}

// ─── Subjects ─────────────────────────────────────────────────────────────────

model Subject {
  id          String   @id
  code        String   @unique
  name        String
  description String?
  type        String?  @default("CORE")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  Examination    Examination[]
  Timetable      Timetable[]
  GradeSubject   GradeSubject[]
  teacherId      String?
  teacher        Teacher?        @relation(fields: [teacherId], references: [id])
  subjectResults SubjectResult[]
  sectionSubjectTeachers SectionSubjectTeacher[]
}

model GradeSubject {
  id             String   @id @default(uuid())
  academicYearId String?
  gradeLevelId   String
  subjectId      String
  createdAt      DateTime @default(now())

  AcademicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  GradeLevel   GradeLevel    @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  Subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, gradeLevelId, subjectId])
}

// ─── Timetable ────────────────────────────────────────────────────────────────

model Timetable {
  id             String   @id
  classSectionId String
  teacherId      String
  dayOfWeek      String
  startTime      String
  endTime        String
  createdAt      DateTime @default(now())
  subjectId      String
  updatedAt      DateTime

  ClassSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  Subject      Subject      @relation(fields: [subjectId], references: [id])
  Teacher      Teacher      @relation(fields: [teacherId], references: [id])
}

// ─── Exams & Attempts ─────────────────────────────────────────────────────────

model Examination {
  id             String     @id @default(uuid())
  title          String
  classSectionId String
  totalMarks     Float
  examDate       DateTime
  createdAt      DateTime   @default(now())
  passingMarks   Float?
  subjectId      String
  termId         String?
  type           ExamType   @default(MIDTERM)
  updatedAt      DateTime
  weightage      Float?
  duration       Int
  status         ExamStatus @default(DRAFT)
  classId        String
  teacherId      String?
  instructions   String?

  // ── Scheduled delivery window ──────────────────────────────────────────────
  // windowStart: when the Start button unlocks for students (server-authoritative)
  // windowEnd:   when the exam closes — no new sessions allowed after this
  // delayMinutes: accumulated teacher-applied delays; added to both window times
  windowStart    DateTime?
  windowEnd      DateTime?
  delayMinutes   Int        @default(0)

  ClassSection ClassSection        @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  Subject      Subject             @relation(fields: [subjectId], references: [id])
  Term         Term?               @relation(fields: [termId], references: [id])
  Class        Class               @relation(fields: [classId], references: [id])
  Teacher      Teacher?            @relation(fields: [teacherId], references: [id])
  ExamAttempt  ExamAttempt[]
  grades       Grade[]
  questions    Question[]
  results      StudentExamResult[]
  sessions     ExamSession[]

  @@index([teacherId, status])
  @@index([classSectionId])
}

model Question {
  id          String              @id @default(uuid())
  examId      String
  examination Examination         @relation(fields: [examId], references: [id], onDelete: Cascade)
  text        String
  options     Option[]
  grades      Grade[]
  results     StudentExamResult[]
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionText String
  isCorrect  Boolean  @default(false)
}

model StudentExamResult {
  id            String          @id @default(uuid())
  examId        String
  examination   Examination     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId     String
  score         Int
  totalMarks    Int
  submittedAt   DateTime        @default(now())
  answers       StudentAnswer[]
  questionId    String?
  question      Question?       @relation(fields: [questionId], references: [id], onDelete: SetNull)
  marksObtained Float           @default(0)
}

model StudentAnswer {
  id               String            @id @default(uuid())
  resultId         String
  result           StudentExamResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  questionId       String
  selectedOptionId String
  isCorrect        Boolean
}

model ExamAttempt {
  id            String   @id
  examId        String
  studentId     String
  marksObtained Float
  grade         String?
  createdAt     DateTime @default(now())
  remarks       String?
  updatedAt     DateTime

  Examination Examination @relation(fields: [examId], references: [id], onDelete: Cascade)
  Student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
}

// ─── Attendance ───────────────────────────────────────────────────────────────

model StudentAttendance {
  id             String           @id
  studentId      String
  classSectionId String
  recordedById   String
  date           DateTime
  period         Int?
  status         AttendanceStatus
  remarks        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime

  ClassSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  User         User         @relation(fields: [recordedById], references: [id])
  Student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date, period])
  @@index([classSectionId, date])
  @@index([studentId, date])
}

// ─── Assignments ──────────────────────────────────────────────────────────────

model Assignment {
  id             String   @id @default(uuid())
  title          String
  instructions   String?
  subject        String?
  targetClass    String?
  dueDate        DateTime
  attachmentUrl  String?
  classSectionId String?
  createdAt      DateTime @default(now())
  description    String?
  classId        String?
  teacherId      String
  updatedAt      DateTime @default(now()) @updatedAt

  ClassSection      ClassSection?       @relation(fields: [classSectionId], references: [id])
  Class             Class?              @relation(fields: [classId], references: [id])
  Teacher           Teacher             @relation(fields: [teacherId], references: [id])
  StudentAssignment StudentAssignment[]
  submissions       Submission[]
  grades            Grade[]

  @@index([teacherId])
  @@index([classSectionId])
  @@map("Assignment")
}

model Submission {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  content      String?
  fileUrl      String?
  fileName     String?
  fileType     String?
  fileSize     Int?
  grades       Grade[]
}

model StudentAssignment {
  id             String  @id
  assignmentId   String
  studentId      String?
  studentLoginId String
  status         String  @default("PENDING")

  Assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  Student    Student?   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// ─── Fees ─────────────────────────────────────────────────────────────────────

model FeeInvoice {
  id        String    @id
  studentId String
  title     String
  amount    Float
  dueDate   DateTime
  isPaid    Boolean   @default(false)
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime

  Student    Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  FeePayment FeePayment[]
}

model FeePayment {
  id            String        @id
  invoiceId     String
  amountPaid    Float
  paymentDate   DateTime      @default(now())
  paymentMethod PaymentMethod @default(CASH)
  transactionId String?       @unique
  remarks       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime

  FeeInvoice FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// ─── Notices ──────────────────────────────────────────────────────────────────

model Notice {
  id         String           @id @default(uuid())
  title      String
  content    String
  category   String           @default("General")
  targetType NoticeTargetType @default(GLOBAL)
  targetRole Role?
  status     NoticeStatus     @default(DRAFT)

  publishedAt DateTime?
  scheduledAt DateTime?
  expiresAt   DateTime?

  authorId  String
  gradeId   String?
  sectionId String?
  studentId String?
  parentId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  User         User          @relation(fields: [authorId], references: [id])
  GradeLevel   GradeLevel?   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  ClassSection ClassSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  Student      Student?      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  Parent       Parent?       @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([status, publishedAt])
}

model Grade {
  id       String @id @default(uuid())
  score    Float  @default(0)
  maxScore Float  @default(100)

  mid        Float? @default(0)
  assignment Float? @default(0)
  quiz       Float? @default(0)
  classwork  Float? @default(0)
  final      Float? @default(0)

  quarter String?
  subject String?

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  assignmentId String?
  Assignment   Assignment? @relation(fields: [assignmentId], references: [id])

  submissionId String?
  Submission   Submission? @relation(fields: [submissionId], references: [id])

  examinationId String?
  questions     Question[]
  Examination   Examination? @relation(fields: [examinationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model SectionSubjectTeacher {
  id             String       @id @default(uuid())
  classSectionId String
  subjectId      String
  teacherId      String
  academicYearId String

  ClassSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  Subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  Teacher        Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  AcademicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([classSectionId, subjectId, academicYearId])
  @@index([teacherId, academicYearId])
}


// ─── Materials (Preserved with exact existing column mappings) ────────────────

model Material {
  id          String    @id @default(uuid())
  title       String
  description String?
  fileUrl     String?   @map("file_url")
  fileName    String?   @map("file_name")
  fileSize    BigInt?   @map("file_size") // Changed from Int? to BigInt? to match your DB
  fileType    String?   @map("file_type")
  category    String?   @map("category")
  targetRole  String?   @map("target_role")
  createdAt   DateTime? @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  userId      String?
  classSectionId String? @map("class_section_id")
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ClassSection ClassSection? @relation(fields: [classSectionId], references: [id], onDelete: SetNull)

  @@map("materials")
}

// ─── Exam Session (per-student live session tracking) ─────────────────────────
// Tracks a single student's active exam attempt for:
//   • Single-device enforcement (only one ACTIVE session per student+exam)
//   • Timer resume after disconnection / power outage
//   • Teacher approval gate after abrupt reconnection

enum ExamSessionStatus {
  ACTIVE
  INTERRUPTED     // student disconnected unexpectedly; timer paused
  AWAITING_RESUME // teacher must approve before student can continue
  COMPLETED
  TIMED_OUT
}

model ExamSession {
  id                   String            @id @default(uuid())
  examinationId        String
  studentId            String
  // Opaque token issued on session start; validated on every answer-save request
  sessionToken         String            @unique
  status               ExamSessionStatus @default(ACTIVE)
  // Seconds remaining at the moment of last save / interruption
  timeRemainingSeconds Int
  // Snapshot of answers as JSON: { [questionId]: selectedOptionId }
  answersJson          String            @default("{}")
  deviceFingerprint    String?           // browser UA + IP hash for single-device check
  startedAt            DateTime          @default(now())
  lastSavedAt          DateTime          @default(now())
  completedAt          DateTime?
  // Set when teacher clicks "Resume Exam" for this session
  resumeApprovedAt     DateTime?
  resumeApprovedById   String?           // Teacher user id who approved

  Examination Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)

  @@unique([examinationId, studentId])
  @@index([status])
  @@index([examinationId, status])
}
