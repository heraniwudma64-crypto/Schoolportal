# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ─── Build outputs ───────────────────────────────────────────────────────────
dist/
build/
**/dist/
**/build/
backend/dist/
frontend/dist/

# ─── Environment & Secrets (NEVER commit real credentials) ───────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
**/.env
**/.env.local
**/.env.*.local
# Allow example/template files only
!.env.example
!**/.env.example

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log.*

# ─── OS & Editor artifacts ───────────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db
.vscode/settings.json
.idea/
*.swp
*.swo

# ─── TypeScript cache ────────────────────────────────────────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo

# ─── Prisma generated client (re-generated on install) ───────────────────────
backend/node_modules/.prisma/

# ─── Test coverage ───────────────────────────────────────────────────────────
coverage/
**/coverage/
